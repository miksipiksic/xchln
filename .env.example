# Bearer token required on all /v1/* routes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=change-me

# --- llm provider (Groq, OpenAI-compatible) ---------------------------------
# Free key from https://console.groq.com/keys . Leave unset and the llm
# provider fails cleanly (job -> "failed") instead of crashing.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CHUNKS=8

# Optional: bind port (default 8000)
PORT=8000
